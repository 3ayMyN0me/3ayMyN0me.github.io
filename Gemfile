source "https://rubygems.org"

# This single gem bundles Jekyll + every plugin GitHub Pages supports,
# locked to the exact versions GitHub runs. Using it means "builds on my
# machine" == "builds on GitHub". Optional — only needed for local preview.
gem "github-pages", group: :jekyll_plugins

# Windows / JRuby helpers (harmless elsewhere)
gem "tzinfo-data", platforms: [:mingw, :mswin, :x64_mingw, :jruby]
gem "wdm", "~> 0.1.1", platforms: [:mingw, :mswin, :x64_mingw]
